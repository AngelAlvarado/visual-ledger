{
  "name": "visual-ledger",
  "displayName": "Visual Ledger",
  "description": "GitHub-style review comments on a Claude claim ledger, written back to comments.md",
  "version": "0.24.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:claudeLedger",
    "onStartupFinished",
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeLedger.review",
        "title": "Ledger: review (rich panel)",
        "icon": "$(preview)"
      },
      {
        "command": "claudeLedger.new",
        "title": "Ledger: new ledger for this conversation",
        "icon": "$(add)"
      },
      {
        "command": "claudeLedger.markWrong",
        "title": "Mark wrong",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "claudeLedger.addNote",
        "title": "Add note",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "claudeLedger.confirm",
        "title": "Confirm",
        "icon": "$(check)"
      },
      {
        "command": "claudeLedger.reload",
        "title": "Ledger: reload comments"
      },
      {
        "command": "claudeLedger.open",
        "title": "Ledger: open a claim ledger"
      },
      {
        "command": "claudeLedger.locate",
        "title": "Ledger: locate ledger.py"
      },
      {
        "command": "claudeLedger.delete",
        "title": "Ledger: delete a ledger"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeLedger.markWrong",
          "when": "false"
        },
        {
          "command": "claudeLedger.addNote",
          "when": "false"
        },
        {
          "command": "claudeLedger.confirm",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "claudeLedger.markWrong",
          "group": "inline@1"
        },
        {
          "command": "claudeLedger.addNote",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "claudeLedger.confirm",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "claudeLedger.review",
          "when": "resourceFilename == ledger.md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Visual Ledger",
      "properties": {
        "claudeLedger.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to ledger.py. Leave empty to auto-detect (workspace, then ~/.claude/plugins)."
        },
        "claudeLedger.dictation.backend": {
          "type": "string",
          "enum": [
            "fake",
            "local",
            "anthropic",
            "custom",
            "off"
          ],
          "default": "fake",
          "enumDescriptions": [
            "Scripted placeholder text -- the microphone is NOT used",
            "faster-whisper on this machine. No token, nothing expires, works offline. Needs: pip install faster-whisper, plus sox",
            "Anthropic's speech socket. Undocumented; needs a claude.ai token that expires in hours",
            "Your own module, named by dictation.backendModule",
            "No dictate button"
          ],
          "description": "Which dictation backend the composer uses. All satisfy the same contract; the page cannot tell them apart."
        },
        "claudeLedger.dictation.tokenPath": {
          "type": "string",
          "default": "",
          "description": "Path to a file holding a claude.ai token. Only used by the 'anthropic' backend. Keep it outside version control."
        },
        "claudeLedger.dictation.language": {
          "type": "string",
          "default": "en",
          "description": "Language code passed to the speech backend."
        },
        "claudeLedger.dictation.backendModule": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a JS module exporting start(channel, callbacks, opts) -> stop(). Used when backend is 'custom'."
        },
        "claudeLedger.dictation.python": {
          "type": "string",
          "default": "python3",
          "description": "Python used for local transcription. Must have faster-whisper installed."
        },
        "claudeLedger.dictation.model": {
          "type": "string",
          "default": "small.en",
          "description": "faster-whisper model, or a local path. tiny.en / base.en / small.en / distil-small.en trade accuracy for speed."
        },
        "claudeLedger.dictation.device": {
          "type": "string",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu",
          "description": "Where the local model runs."
        },
        "claudeLedger.dictation.computeType": {
          "type": "string",
          "default": "int8",
          "description": "int8 on CPU, float16 on a GPU."
        }
      }
    }
  }
}

{
  "name": "visual-ledger",
  "displayName": "Visual Ledger",
  "description": "GitHub-style review comments on a Claude claim ledger, written back to comments.md",
  "version": "0.15.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:claudeLedger",
    "onStartupFinished",
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeLedger.review",
        "title": "Ledger: review (rich panel)",
        "icon": "$(preview)"
      },
      {
        "command": "claudeLedger.markWrong",
        "title": "Mark wrong",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "claudeLedger.addNote",
        "title": "Add note",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "claudeLedger.confirm",
        "title": "Confirm",
        "icon": "$(check)"
      },
      {
        "command": "claudeLedger.reload",
        "title": "Ledger: reload comments"
      },
      {
        "command": "claudeLedger.open",
        "title": "Ledger: open a claim ledger"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeLedger.markWrong",
          "when": "false"
        },
        {
          "command": "claudeLedger.addNote",
          "when": "false"
        },
        {
          "command": "claudeLedger.confirm",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "claudeLedger.markWrong",
          "group": "inline@1"
        },
        {
          "command": "claudeLedger.addNote",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "claudeLedger.confirm",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "claudeLedger.review",
          "when": "resourceFilename == ledger.md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Visual Ledger",
      "properties": {
        "claudeLedger.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to ledger.py. Leave empty to auto-detect (workspace, then ~/.claude/plugins)."
        },
        "claudeLedger.dictation.backend": {
          "type": "string",
          "enum": [
            "fake",
            "off"
          ],
          "default": "fake",
          "enumDescriptions": [
            "Scripted placeholder text -- the microphone is NOT used",
            "No dictate button"
          ],
          "description": "Which dictation backend the composer uses."
        }
      }
    }
  }
}
